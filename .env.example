# --- Core ---
NODE_ENV=production
PORT=8080
PUBLIC_URL=https://app.example.com
DATABASE_URL=postgres://creator:creator@localhost:5432/creator
REDIS_URL=redis://localhost:6379
# Generate each with: openssl rand -base64 48
JWT_SECRET=
QUOTE_SECRET=
FILE_URL_SECRET=
ADMIN_EMAILS=founder@example.com

# --- Email (verification + password reset) ---
MAIL_DRIVER=resend
MAIL_FROM=Creator Studio <no-reply@yourdomain.com>
RESEND_API_KEY=
REQUIRE_EMAIL_VERIFICATION=true

# --- Credit economics (1 credit ~= INR 0.25 of marked-up provider cost) ---
USD_INR=84
INR_PER_CREDIT_COST=0.25
PRICE_MARKUP=1.6

# --- AI providers (server-side only; leave blank to disable a provider) ---
OPENAI_API_KEY=
OPENAI_CODE_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
# owner/name for official models, or owner/name:version. Check each model's input schema and licence.
REPLICATE_VIDEO_MODEL=
REPLICATE_3D_MODEL=
REPLICATE_MUSIC_MODEL=
REPLICATE_COMMERCIAL_LICENSE_CONFIRMED=false
ELEVENLABS_API_KEY=
# Aggregators: one key each unlocks many models. OpenRouter = hundreds of text/code models
# (incl. free ones), synced daily; fal.ai = image and video models (edit in Admin > Models).
OPENROUTER_API_KEY=
FAL_KEY=
# Web search for Research mode and agents (first one set is used)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARCH_COST_USD=0.01
APP_NAME=Creator Studio
# Referral rewards in credits, paid after the referred user's first payment
REFERRAL_REFERRER_CREDITS=300
REFERRAL_REFEREE_CREDITS=100
MODERATION_ENABLED=true
ENABLE_MOCK_PROVIDER=false

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_IDS={"starter":"plan_xxx","creator":"plan_xxx","pro":"plan_xxx","studio":"plan_xxx"}

# --- Invoicing (India GST) ---
# Printed on every invoice; required in production once Razorpay is configured.
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_STATE_CODE=27
# Leave empty if not GST-registered: a Bill of Supply (no tax) is issued instead.
SELLER_GSTIN=
# Required with SELLER_GSTIN. Confirm the SAC code and rate with your CA.
GST_SAC_CODE=
GST_RATE_PERCENT=18
# true: plan/pack prices already include GST
PRICES_INCLUDE_GST=true
INVOICE_PREFIX=INV

# --- Storage ---
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=ap-south-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# --- Monitoring (optional) ---
SENTRY_DSN=
# Slack or Discord incoming webhook for operational alerts
ALERT_WEBHOOK_URL=
# Enables GET /metrics (Prometheus) with "Authorization: Bearer <token>"; min 16 chars
METRICS_TOKEN=

# --- Worker ---
WORKER_CONCURRENCY=4
RUN_WORKER_IN_API=false
JOB_TIMEOUT_SEC=900
